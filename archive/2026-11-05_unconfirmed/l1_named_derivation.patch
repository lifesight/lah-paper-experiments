+    assert led.find_ungrounded("1,845,225.66 + 788,062.85 = 2,633,288.51.") == []
+    # an operand ten units off is not the platform's figure, however the direct class restates it
+    assert led.find_ungrounded("1,845,229.99 + 788,062.85 = 2,633,292.84.") == [2633292.84]
+
+
