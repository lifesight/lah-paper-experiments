+
+
+def test_the_arithmetic_is_checked_on_the_platforms_figures_to_the_claims_last_digit() -> None:
+    """Review of 2026-11-05: a rounded claim could be one step off when its operands were compact or short, and a
+    cent-level claim ten units off past six digits. The sum is now computed from the figures the operands name and
+    held to the last digit the claim is written with."""
