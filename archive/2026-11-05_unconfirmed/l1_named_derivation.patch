diff --git a/tests/test_named_sums.py b/tests/test_named_sums.py
new file mode 100644
index 00000000..c5b3f261
--- /dev/null
+++ b/tests/test_named_sums.py
@@ -0,0 +1,193 @@
+"""An amount the answer computes must be produced by the operands the answer names (owner, 2026-11-05, L1).
+
+Until now a sum, a difference or a per-count average was grounded by a blind search: "does SOME pair of this
+result's bases add to the claim". Measured on the recorded staging turns (`cap_study_real.py` in the harness
+paper's experiments), a real read carries about 2,100 base-eligible figures, so the 300-base pool is one read's
+and the search accepted 3.75% to 6.75% of random six-figure amounts in the read's own band while deriving only
+19% to 28% of honest sums over it (the pool holds the read's first 300 figures). Widening the pool bought recall
+with fabrications one for one.
+
+The rule this file pins, the one the ratio rule set on 2026-09-20: an amount is grounded by arithmetic when the
+answer NAMES its two operands in the same sentence (`A + B = C`, `C (computed as A - B)`, `C per day (A / 30)`),
+each operand is a figure ONE tool result carries (the same result for both), and the arithmetic holds at the
+precision the claim is written with. The blind pairwise search is closed for prose; it stays available to a caller
+weighing its own figure against one read (`pair_search=True`, as `ratio_search` does for the finding explainer).
+
+What this costs, knowingly: a sum the model does not show reads `[unverified]`, exactly as an unshown ratio has
+since 2026-09-20. Column totals and means, group totals and the named cross-result class are unchanged.
+"""
+
+from __future__ import annotations
+
+from harness_core.provenance import NumberLedger
+
+RESULT = {
+    "performance": [
+        {"parentId": "google", "campaign": "brand", "spend": 2000000.00, "pRevenue": 15000000.00},
+        {"parentId": "google", "campaign": "nonbrand", "spend": 1845225.66, "pRevenue": 14468433.10},
+        {"parentId": "youtube", "campaign": "awareness", "spend": 900000.00, "pRevenue": 1500000.00},
+        {"parentId": "youtube", "campaign": "consideration", "spend": 788062.85, "pRevenue": 1234504.73},
+    ],
+    "window": {"days": 30},
+}
+OTHER_RESULT = {"plan": {"total_spend": 500000.00, "channels": [{"name": "google", "spend": 320000.00}]}}
+
+
+def _ledger() -> NumberLedger:
+    led = NumberLedger()
+    led.add_from(RESULT, kind="result:attribution_report")
+    led.add_from(OTHER_RESULT, kind="result:plans_get")
+    return led
+
+
+def _why(text: str, raw: str) -> str | None:
+    return {f.raw: w for f, w in _ledger().explained(text)}[raw]
+
+
+def test_a_sum_the_text_does_not_explain_is_unverified() -> None:
+    """The blind search is closed: 2,000,000.00 + 900,000.00 is a pair of this result, and that no longer counts."""
+    assert _ledger().find_ungrounded("Together the two campaigns spent 2,900,000.00.") == [2900000.0]
+
+
+def test_a_sum_written_with_its_operands_is_derived() -> None:
+    text = "Brand and awareness together: 2,000,000.00 + 900,000.00 = 2,900,000.00."
+    assert _ledger().find_ungrounded(text) == []
+    assert _why(text, "2,900,000.00") == "2000000 + 900000"
+
+
+def test_the_operands_may_follow_the_claim_in_a_parenthesis() -> None:
+    text = "Brand outspent awareness by 1,100,000.00 (computed as 2,000,000.00 - 900,000.00)."
+    assert _ledger().find_ungrounded(text) == []
+    assert _why(text, "1,100,000.00") == "2000000 - 900000"
+
+
+def test_a_per_count_average_names_the_count_the_result_carries() -> None:
+    text = "Brand spent 66,666.67 per day (2,000,000.00 / 30)."
+    assert _ledger().find_ungrounded(text) == []
+    assert _why(text, "66,666.67") == "2000000 / 30"
+
+
+def test_operands_are_written_as_the_platform_wrote_them() -> None:
+    """A rounded operand would match some figure of a large read by coincidence as often as a rounded claim does
+    (two-figure claims coincide 31% to 62% of the time on the recorded reads), and two of them would make almost any
+    sum. So the operands are written in full; the total may be rounded, and a rounded restatement may follow."""
+    # 1,845,225.66 and 788,062.85 rounded: neither is a figure the result carries (2.0M would be: it IS 2,000,000.00)
+    assert _ledger().find_ungrounded("Together about $2.6M ($1.8M + $0.79M).") == [2600000.0]
+    assert _ledger().find_ungrounded("Together about $2.6M (1,845,225.66 + 788,062.85).") == []
+    led = NumberLedger()
+    led.add_from({"channels": [{"name": "a", "spend": 45000}, {"name": "b", "spend": 250.50}]}, kind="result:a")
+    assert led.find_ungrounded("a and b together: 45,000 + 250.50 = 45,250.50.") == [], \
+        "a short figure written to the last digit is the platform's figure"
+    two_dec = NumberLedger()
+    two_dec.add_from({"rows": [{"spend": 456.7891}, {"spend": 1234.5678}]}, kind="result:a")
+    assert two_dec.find_ungrounded("Together 1,234.57 + 456.79 = 1,691.36.") == [], \
+        "a figure written to two decimals, as the figure style asks, is the platform's figure"
+    # 457 is 456.7891 at three digits; the sum is checked on the platform's figures (1,691.36), not on the prose
+    assert two_dec.find_ungrounded("Together 1,234.57 + 457 = 1,691.36.") == []
+    assert two_dec.find_ungrounded("Together 1,234.57 + 457 = 1,691.57.") == [1691.57]
+    # 460 restates 456.7891 loosely at two figures (the direct class), yet as an operand it is not that figure
+    assert two_dec.find_ungrounded("Together 1,234.57 + 460 = 1,694.57.") == [1694.57]
+    # (45,250 would restate the column total 45,250.50 loosely, so the wrong operand here is 350, not 250)
+    assert led.find_ungrounded("a and b together: 45,000 + 350 = 45,350.") == [350.0, 45350.0], \
+        "350 is not a figure of the result, so neither it nor the sum it names is grounded"
+
+
+def test_operands_from_two_results_do_not_combine() -> None:
+    """Two figures the platform returned together are what an answer legitimately combines (review 2026-09-05);
+    a plan's figure and a report's figure stay apart, as the cross-result class (E13) requires a named field."""
+    text = "Report plus plan: 2,000,000.00 + 500,000.00 = 2,500,000.00."
+    assert _ledger().find_ungrounded(text) == [2500000.0]
